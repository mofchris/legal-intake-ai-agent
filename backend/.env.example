# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set DEMO_MODE=true to return deterministic mock analysis without calling
# OpenAI. Lets reviewers run the app with no API key.
DEMO_MODE=false

# App
APP_ENV=development
DATABASE_PATH=data/intake_records.sqlite3
AUDIT_LOG_PATH=logs/audit.jsonl
LOG_REDACT_PII=true
MAX_DESCRIPTION_CHARS=10000

# CORS: comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Optional Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# Optional Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Intake Records
